# stt_api.evaluation — configuration for the OPTIONAL LLM normalization pass.
#
# You do NOT need any of this for the default mode. `score(hyp, ref)` and
# `--mode deterministic` are pure rules: no key, no endpoint, no network. These
# three variables only matter for mode="llm" / "both" / "pair".
#
# THIS FILE IS A CONVENIENCE, NOT A REQUIREMENT. Exporting the variables is
# always enough, and is the normal path for a `pip install git+...` copy that has
# nowhere sensible to keep a .env:
#
#     export OPENAI_BASE_URL=https://your-endpoint.example.com/v1
#     export OPENAI_API_KEY=sk-...
#     export MODEL_NAME=your-model-id
#
#     python3 -c "from stt_api.evaluation import score; \
#                 print(score('okay lah', 'ok la', mode='llm').normalized_wer)"
#
# From a source checkout you can instead copy this file and point at it:
#
#   cp stt_api/evaluation/.env.example stt_api/evaluation/.env
#   LLMClient.from_env(env_file="stt_api/evaluation/.env")
#
# `.env` is git-ignored; `.env.example` is not. Keep secrets in the former.

# ----------------------------------------------------------------- required --

# OpenAI-compatible endpoint. MUST end in /v1 — the client posts to
# {OPENAI_BASE_URL}/chat/completions. Anything that speaks that route works:
#   vLLM          http://localhost:8000/v1
#   OpenRouter    https://openrouter.ai/api/v1
#   OpenAI        https://api.openai.com/v1
#   internal      https://your-llm-proxy.example.com/v1
OPENAI_BASE_URL=https://your-llm-endpoint.example.com/v1

# Sent as `Authorization: Bearer <key>`. A self-hosted vLLM that checks nothing
# still needs a non-empty value here — the client treats a missing key as
# "not configured" and refuses to run an LLM mode rather than silently reporting
# a number that was never normalized.
OPENAI_API_KEY=sk-replace-me

# Model id as the endpoint names it. MODEL_NAME wins; OPENAI_MODEL also works.
MODEL_NAME=your-model-id

# ----------------------------------------------------------------- optional --

# Only for load_canonical() against a GATED HuggingFace dataset (e.g.
# Revolab/ASR-Benchmark-Public). Nothing else here reads it.
# HF_TOKEN=hf_...

# -------------------------------------------------------------------- usage --
#
#   from stt_api.evaluation import LLMClient, score
#
#   client = LLMClient.from_env(env_file="stt_api/evaluation/.env")
#   r = score(hyps, refs, mode="both", client=client)
#
# `LLMClient.from_env()` with no argument reads the process environment only.
# Precedence is:  .env file  <  process environment  <  explicit argument.
# Reading a .env NEVER mutates os.environ — a library that edits the process
# environment on import breaks the application hosting it.
#
# On the command line:
#
#   python -m stt_api.evaluation --input pairs.csv --mode both \
#       --env-file stt_api/evaluation/.env
#
# ⚠ Expect the LLM pass to be a small effect. Measured on 820 clips it added
# ~0.08 pp beyond the free deterministic layer, for ~2 billed calls per clip.
