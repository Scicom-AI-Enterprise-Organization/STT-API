STT_API_URL=https://stt-engine-rtx.aies.scicom.dev

# audio processing settings
SAMPLE_RATE=16000
MAX_CHUNK_LENGTH=25

# vad settings 
MINIMUM_SILENT_MS=200
MINIMUM_TRIGGER_VAD_MS=1500
REJECT_SEGMENT_VAD_RATIO=0.9
VAD_WORKERS=8

# thread limit stuffs 
OMP_NUM_THREADS=2
OPENBLAS_NUM_THREADS=2
MKL_NUM_THREADS=2

# concurrency settings
MAX_CONCURRENT_REQUESTS=20
MAX_CONCURRENT_UPSTREAM=100
CHUNK_BATCH_SIZE=8

# diarization settings
OSD_API_URL=http://osd:8000
ENABLE_ONLINE_DIARIZATION=true
SPEAKER_EMBEDDING_BATCH_SIZE=16
SPEAKER_PRECISION_MODE=FP16

# transcription scoring (stt_api.evaluation)
# The WER/CER scorer needs none of this by default. Its OPTIONAL LLM normalization
# pass is configured separately in stt_api/evaluation/.env — see
# stt_api/evaluation/.env.example

# ------------------------------------------------------------------- S3 ------
# Audio corpus for the VAD benchmark
# (stt_api/livekit_plugin/pulse_vad/benchmark). Nothing else in the repo reads
# these, and the benchmark runs without them on local files:
#
#   python -m stt_api.livekit_plugin.pulse_vad.benchmark --audio test_audio/
#
# Credentials resolve in this order, first hit wins:
#   1. S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY below
#   2. AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY in the environment
#   3. the ambient boto3 chain — ~/.aws/config profiles, SSO, instance roles
# So an SSO login (`aws sso login --profile scicom`) is enough on its own; the
# keys here are for CI and for non-AWS providers that have no SSO.

# Custom endpoint for S3-compatible storage — MinIO, Cloudflare R2, Wasabi,
# Ceph. LEAVE BLANK for real AWS S3: boto3 builds the regional endpoint itself,
# and a wrong explicit value fails as a DNS error rather than an auth error.
S3_ENDPOINT_URL=

# Required for a custom endpoint, optional for AWS (falls back to the profile's).
S3_REGION=your-region

# Static keys. Leave blank to use SSO or an instance role (see the order above).
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Only for temporary STS credentials; blank for long-lived keys.
S3_SESSION_TOKEN=

# Where the benchmark audio lives.  s3://$S3_BUCKET/$S3_PREFIX
S3_BUCKET=
S3_PREFIX=

# MinIO and most self-hosted gateways need "path"; AWS and R2 want "virtual".
# Blank lets boto3 choose, which is right for AWS.
S3_ADDRESSING_STYLE=
